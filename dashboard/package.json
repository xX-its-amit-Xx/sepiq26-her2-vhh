{
  "name": "sepiq-2026-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "sync": "node scripts/sync-content.mjs",
    "data": "node scripts/build-data.mjs",
    "prebuild": "node scripts/build-data.mjs && node scripts/sync-content.mjs",
    "predev": "node scripts/build-data.mjs && node scripts/sync-content.mjs",
    "check": "node scripts/check-leaks.mjs",
    "deploy": "npm run build && node scripts/check-leaks.mjs && wrangler pages deploy out --project-name sepiq26-intelligence --branch main --commit-dirty=true"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
